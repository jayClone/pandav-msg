# Backend Configuration
PORT=5000
NODE_ENV=development

# ✅ MongoDB Atlas - Replace with your actual connection string
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/pandav?retryWrites=true&w=majority

# ✅ Generate with: openssl rand -base64 32
JWT_SECRET=your_generated_jwt_secret_min_32_chars_long_here

JWT_EXPIRE=7d
API_VERSION=v1

# Frontend URL
CLIENT_URL=http://localhost:5173

# Logging
LOG_LEVEL=info