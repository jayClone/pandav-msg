
# Port number
PORT=5000

# MongoDB connection URI
MONGO_URI=mongodb://localhost:27017/your_database

# JWT secret key for ACCESS tokens (generate with: openssl rand -hex 32)
JWT_SECRET=your_super_secret_jwt_key

# JWT secret key for REFRESH tokens — must be a DIFFERENT value than JWT_SECRET.
# If unset, the app falls back to reusing JWT_SECRET, which lets a leaked
# refresh token be used as an access token. Always set this explicitly.
JWT_REFRESH_SECRET=your_different_super_secret_refresh_key

# Access token expiration — keep this SHORT (access tokens can't be revoked
# early, so a leaked one stays valid for this whole window)
JWT_ACCESS_EXPIRE=15m

# Refresh token expiration — long-lived, presented only via the httpOnly cookie
JWT_REFRESH_EXPIRE=30d

# NOTE: if this project is run with `bun run`, Bun auto-loads .env.local
# BEFORE this file and its values silently win — make sure .env.local (if
# present) has real secrets too, not leftover placeholders.

# Node environment
NODE_ENV=development

# API version
API_VERSION=v1

# Client application URL
CLIENT_URL=http://localhost:3000

# Resend API key
RESEND_API_KEY=re_123456789

# Resend from email address
RESEND_FROM_EMAIL=noreply@example.com

# Resend from name
RESEND_FROM_NAME=YourAppName

# Frontend application URL
FRONTEND_URL=http://localhost:3000

# OTP expiry in minutes
OTP_EXPIRY_MINUTES=10

# Maximum OTP attempts
OTP_MAX_ATTEMPTS=5

# OTP length
OTP_LENGTH=6

# Redis
REDIS_URL=redis://localhost:6379

ARCJET_KEY=ajkey_your key
ARCJET_ENV=development
