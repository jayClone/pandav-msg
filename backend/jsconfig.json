{
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "app/*": ["src/*"],
      "@controllers/*": ["src/controllers/*"],
      "@models/*": ["src/models/*"],
      "@routes/*": ["src/routes/*"],
      "@middlewares/*": ["src/middlewares/*"],
      "@config/*": ["src/config/*"],
      "@socket/*": ["src/socket/*"],
      "@constants/*": ["src/constant/*"],
      "@utils/*": ["src/utils/*"],
      "@tests/*": ["src/tests/*"],
      "@v1/*": ["src/routes/v1/*"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}