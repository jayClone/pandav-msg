{
  "buildCommand": "bun run build",
  "devCommand": "bun run dev",
  "installCommand": "npm install -g bun && bun install",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://pandav-msg.up.railway.app/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}